% A CHR solver for `leq`, written in ELPI (tier T1 of the solver API).
% @tg: implements:: [[openspec:elpi-solver-api#CHR solvers in ELPI]]
% Reflexivity, idempotence, antisymmetry and transitivity: a cycle of `leq` collapses.
% Load it with `accumulate leq.`

constraint leq {
  rule \ (leq X X).
  rule (leq X Y) \ (leq X Y).
  rule (leq X Y) \ (leq Y X) <=> (X = Y).
  rule (leq X Y) (leq Y Z) <=> (leq X Z).
}

pred leq o:A, o:A.
leq A B :- declare_constraint (leq A B) [A, B].
